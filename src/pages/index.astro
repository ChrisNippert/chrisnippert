---
import Base from "@/layouts/Base.astro";

const liveSites = [
  {
    title: "Tachyonic",
    href: "https://tachyonic.chrisnippert.com/",
    summary: "A shared url-based application for collaborative work.",
  },
  {
    title: "Relay",
    href: "https://relay.chrisnippert.com/",
    summary: "A chat app Specification including a server written in GO with a frontend built with React, Node.js, and WebSockets, featuring real-time messaging, voice and video channels, and End to End Encryption (E2EE).",
  }
];
---

<Base title="ChrisNippert" description="CS · AI/ML · Music">
    <section class="space-y-8">
        <div class="space-y-2">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight bg-gradient-to-r from-text via-accent-soft to-accent bg-clip-text text-transparent">
                ChrisNippert
            </h1>
            <p class="text-accent-soft text-sm font-medium tracking-wide">CS · AI/ML · Music</p>
        </div>

        <div class="flex flex-wrap gap-2">
            {["Julia", "Python", "Java", "C", "Go", "React", "Astro"].map(tag => (
                <span class="rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-xs text-accent-soft">{tag}</span>
            ))}
        </div>

        <div class="text-text-muted max-w-prose space-y-4 text-sm sm:text-base leading-relaxed">
            <p>
                I'm a Graduate student at UNH studying Computer Science with interests in AI, ML, and NLP.
                I also have interest in parallel computing with multithreading, distributed systems, and GPU programming.
                I have programming skills in many languages including Julia, Python, Java, and C. I've made a bunch
                of fun side projects in my free time as well.
            </p>
            <p>
                I also write and produce music. I've been drumming for most of my life,
                and been playing guitar since high school. I challenged myself to make a
                song every day for the month of December, and continued the
                tradition for a couple of years. This was enough to get me over my
                unreasonable goal of a perfect song that was stopping me from
                releasing music. I am now focusing on more quality than quantity, 
                getting better at singing and writing interesting and cohesive stories.
            </p>
            <p>
                I have a blog with some thoughts and ideas about various topics.
            </p>
        </div>

        <div class="flex flex-wrap gap-3">
            <a
                href="/blog"
                class="inline-block rounded-xl border border-border bg-bg-card px-4 py-2 hover:border-accent/40 hover:text-accent-soft transition-colors duration-200 text-sm sm:text-base"
            >Read the blog →</a>
            <a
                href="/programming"
                class="inline-block rounded-xl border border-border bg-bg-card px-4 py-2 hover:border-accent/40 hover:text-accent-soft transition-colors duration-200 text-sm sm:text-base"
            >View projects →</a>
            <a
                href="/music"
                class="inline-block rounded-xl border border-border bg-bg-card px-4 py-2 hover:border-accent/40 hover:text-accent-soft transition-colors duration-200 text-sm sm:text-base"
            >Listen →</a>
        </div>

        <hr class="border-border" />

        <div class="space-y-2">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-text-muted">Live Sites</h2>
            <ul class="flex flex-wrap gap-3">
                {liveSites.map(s => (
                    <li>
                        <a
                            href={s.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex items-center gap-2 rounded-xl border border-border bg-bg-card px-3 py-2 text-sm hover:border-accent/40 transition-colors"
                        >
                            <span class="h-1.5 w-1.5 rounded-full bg-green-400 shrink-0" aria-hidden="true"></span>
                            <span class="font-medium group-hover:text-accent-soft transition-colors">{s.title}</span>
                            <span class="text-text-muted text-xs hidden sm:inline">— {s.summary}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>
</Base>
