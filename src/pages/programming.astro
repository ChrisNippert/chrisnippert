  <!-- GitHub Portfolio Section -->
  <section class="space-y-4">
    <header class="space-y-1">
      <h1 class="text-3xl font-semibold tracking-tight">My Programming Portfolio</h1>
      <p class="text-text-muted">Selected projects I’ve built or actively maintain.</p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
      {projects.map((p) => (
        <li class="group relative flex flex-col rounded-2xl border border-border bg-bg-card overflow-hidden transition duration-200 hover:-translate-y-0.5 hover:border-accent/30">
          <div class="flex flex-col flex-1 p-4">
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-base font-semibold">{p.title}</h2>
              <a
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${p.title} on GitHub`}
                class="relative z-10 shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-border px-2 py-1 text-xs text-text-muted transition hover:border-accent/40 hover:text-accent-soft"
              >
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd"
                    d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.2c-3.22.7-3.9-1.55-3.9-1.55-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.72.08-.72 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.39.97.11-.76.41-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.76 0-1.27.46-2.31 1.2-3.12-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.21 1.19a11.1 11.1 0 0 1 5.84 0c2.23-1.5 3.21-1.19 3.21-1.19.63 1.59.23 2.77.11 3.06.75.81 1.2 1.85 1.2 3.12 0 4.48-2.71 5.46-5.29 5.75.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/>
                </svg>
                Repo
              </a>
            </div>
            <p class="mt-1.5 text-sm text-text-muted">{p.summary}</p>
            {p.image && (
              <div class="mt-3 overflow-hidden rounded-lg border border-border">
                <img
                  src={p.image}
                  alt={p.title}
                  class="w-full h-40 object-cover transition duration-300 group-hover:scale-105"
                />
              </div>
            )}
          </div>
          <a href={`/projects/${p.slug}`} class="absolute inset-0" aria-label={p.title} />
        </li>
      ))}
    </ul>
  </section>
</Base>
