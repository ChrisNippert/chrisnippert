---
import Base from "@/layouts/Base.astro";
import { projects, type Project } from "@/data/projects";

export async function getStaticPaths() {
  const paths = await Promise.all(
    projects.map(async (p) => {
      let readmeHtml = "";
      try {
        if (import.meta.env.PROD) {
          const headers: Record<string, string> = {
            Accept: "application/vnd.github.html+json",
          };
          if (import.meta.env.GITHUB_TOKEN) {
            headers["Authorization"] = `Bearer ${import.meta.env.GITHUB_TOKEN}`;
          }
          const res = await fetch(
            `https://api.github.com/repos/${p.repo}/readme`,
            { headers }
          );
          if (res.ok) readmeHtml = await res.text();
        }
      } catch {
        // README unavailable — page will show fallback
      }
      return {
        params: { slug: p.slug },
        props: { project: p, readmeHtml },
      };
    })
  );
  return paths;
}

const { project, readmeHtml } = Astro.props as {
  project: Project;
  readmeHtml: string;
};
---

<Base
  title={`${project.title} – ChrisNippert`}
  description={project.summary}
>
  <div class="space-y-4">
    <!-- Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-1">
        <a
          href="/programming"
          class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent-soft transition-colors"
        >
          ← All projects
        </a>
        <h1 class="text-3xl font-bold tracking-tight">{project.title}</h1>
        {project.labels && (
          <div class="flex flex-wrap gap-2">
            {project.labels.map((label) => (
              <span class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-1 text-xs font-medium uppercase tracking-wider text-accent-soft">{label}</span>
            ))}
          </div>
        )}
        <p class="text-text-muted text-sm">{project.summary}</p>
      </div>
      <a
        href={project.href}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 rounded-xl border border-border bg-bg-card px-4 py-2 text-sm hover:border-accent/40 hover:text-accent-soft transition-colors"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.2c-3.22.7-3.9-1.55-3.9-1.55-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.72.08-.72 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.39.97.11-.76.41-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.76 0-1.27.46-2.31 1.2-3.12-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.21 1.19a11.1 11.1 0 0 1 5.84 0c2.23-1.5 3.21-1.19 3.21-1.19.63 1.59.23 2.77.11 3.06.75.81 1.2 1.85 1.2 3.12 0 4.48-2.71 5.46-5.29 5.75.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          />
        </svg>
        Go to repo
      </a>
    </div>

    <hr class="border-border" />

    {project.image && (
      <img
        src={project.image}
        alt={project.title}
        class="w-full rounded-xl border border-border object-cover"
      />
    )}

    {project.aiAssistance && (
      <section class="ui-card rounded-xl border border-border bg-bg-card p-5">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent-soft">AI transparency</p>
        <h2 class="mt-2 text-lg font-semibold">How AI tools were used</h2>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">AI tools supported this project in the following areas:</p>
        <ul class="mt-3 grid gap-2 text-sm text-text-muted sm:grid-cols-2">
          {project.aiAssistance.uses.map((use) => (
            <li class="flex items-start gap-2">
              <span class="mt-1 text-accent-soft" aria-hidden="true">•</span>
              <span>{use}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {project.caseStudy && (
      <section class="ui-card rounded-xl border border-border bg-bg-card p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent-soft">Technical case study</p>
        <div class="mt-4 grid gap-6 lg:grid-cols-2">
          <div>
            <h2 class="text-lg font-semibold">Problem</h2>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{project.caseStudy.problem}</p>
          </div>
          <div>
            <h2 class="text-lg font-semibold">Next step</h2>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{project.caseStudy.nextStep}</p>
          </div>
        </div>
        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <div>
            <h2 class="text-lg font-semibold">Approach</h2>
            <ol class="mt-3 grid gap-3 text-sm leading-relaxed text-text-muted">
              {project.caseStudy.approach.map((step, index) => (
                <li class="flex gap-3">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-accent/30 text-xs text-accent-soft">{index + 1}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </div>
          <div>
            <h2 class="text-lg font-semibold">Results</h2>
            <ul class="mt-3 grid gap-3 text-sm leading-relaxed text-text-muted">
              {project.caseStudy.results.map((result) => (
                <li class="flex gap-2">
                  <span class="mt-0.5 text-accent-soft" aria-hidden="true">•</span>
                  <span>{result}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- README -->
    {readmeHtml ? (
      <article class="prose prose-invert max-w-none" set:html={readmeHtml} />
    ) : import.meta.env.PROD ? (
      <p class="text-text-muted">No README found for this project.</p>
    ) : (
      <p class="text-text-muted italic">README preview only available in production build.</p>
    )}
  </div>
</Base>
